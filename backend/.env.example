# Copy to .env and fill in. Never commit .env.
PORT=3000
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=medicine_donor

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary image storage (https://console.cloudinary.com -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medicine-donor

# Email for password-reset codes (Gmail App Password)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
