# Copy to .env and fill in. Never commit .env.
PORT=3000
MONGODB_URI=mongodb+srv://<your-cluster-host>/
DATABASE_NAME=medicine_donor

# MongoDB: X.509 certificate authentication only (no username/password).
# MONGODB_URI holds only the host, e.g. mongodb+srv://cluster0.xxxxx.mongodb.net/
# The PEM holds the client certificate + private key (see backend/certs/README.md).
MONGODB_TLS_CERT_KEY_FILE=./certs/mongodb-client.pem
# Only for servers with a private/self-signed CA (not needed for MongoDB Atlas):
MONGODB_TLS_CA_FILE=

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary image storage (https://console.cloudinary.com -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medicine-donor

# Email for password-reset codes (Gmail App Password)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Browser origins allowed to call the API (comma-separated). Default: the Vite dev server.
# CORS_ORIGINS=https://your-frontend.example.com,http://localhost:5173

# JWT_SECRET and JWT_REFRESH_SECRET are required: two different random values,
# at least 32 characters each. The server refuses to start without them.

# Test data (`cargo run -- seed-test-data`) only runs when ALLOW_SEED=1 is set.
# Never set it against a production database.

# Refresh-token cookie (HttpOnly; the browser's JavaScript can never read it).
# COOKIE_SECURE=false only for plain-HTTP testing on a non-localhost host.
# COOKIE_SAMESITE=none when the frontend and API are on different sites
#   (e.g. netlify.app + onrender.com); requires HTTPS and the frontend origin in CORS_ORIGINS.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict
