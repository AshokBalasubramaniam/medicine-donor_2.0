# Secrets — never commit (see backend/.env.example)
.env
.env.*
!.env.example

# Certificates and private keys (MongoDB X.509, TLS)
*.pem
*.key
*.crt
*.p12
backend/certs/*
!backend/certs/README.md

# Dependencies & build output
node_modules/
dist/
build/
backend/target/

# User-uploaded files (images now live on Cloudinary)
backend/uploads/
backend/src/uploads/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.log
